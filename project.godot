; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Up the Ante"
run/main_scene="uid://dky0g7hmpb1nj"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

SignalBus="*res://Scripts/Globals/signal_bus.gd"
Utils="*res://Scripts/Globals/utils.gd"
Locator="*res://Scripts/Globals/locator.gd"
SceneTransition="*res://scene_transition.tscn"
TrickHandler="*res://Scripts/Globals/trick_handler.gd"
BossHandler="*res://Scripts/Globals/boss_handler.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/mode=2
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray()

[global_group]

Player=""

